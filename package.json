{
  "name": "rustsharp-vscode",
  "version": "0.1.0",
  "private": true,
  "description": "Extensión de VSCode para R# (Rust#): el lenguaje C# que se transpila a Rust.",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git@github.com:GabrielCatDeveloper/RustSharpVsCode.git"
  },
